<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema de la ventana; los colores de la UI viven en Compose (core/designsystem/theme) -->
    <style name="Theme.Fulbo" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/fulbo_background</item>
        <item name="android:statusBarColor">@color/fulbo_background</item>
        <item name="android:navigationBarColor">@color/fulbo_background</item>
    </style>

    <style name="Theme.Fulbo.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fulbo_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Fulbo</item>
    </style>
</resources>
